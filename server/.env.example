PORT=4000
NODE_ENV=development

SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

JWT_SECRET=replace_with_a_long_random_secret

FRONTEND_URL=https://sentinel-omega-ten.vercel.app
CORS_ORIGINS=https://sentinel-omega-ten.vercel.app,https://sentinel-mvp-nine.vercel.app

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Maximum emergency contacts per user
MAX_EMERGENCY_CONTACTS=10

# Notification providers
# Twilio WhatsApp credentials. Used for invite messages and SOS alerts.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Firebase service account credentials for push notifications (FCM).
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"

# Optional. Defaults to 5 minutes.
NOTIFICATION_REPEAT_INTERVAL_MS=300000

# Admin dashboard access. Required by the separate admin/ app to read /api/admin/stats.
ADMIN_API_KEY=replace_with_a_long_random_secret
