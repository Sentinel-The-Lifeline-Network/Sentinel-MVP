PORT=4000
NODE_ENV=development

SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

JWT_SECRET=replace_with_a_long_random_secret

FRONTEND_URL=https://sentinel-omega-ten.vercel.app
CORS_ORIGINS=https://sentinel-omega-ten.vercel.app,https://sentinel-mvp-nine.vercel.app

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Notification providers
# Twilio credentials. Sentinel tries WhatsApp first, then falls back to SMS.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_FROM=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Gmail SMTP credentials. Use a Gmail App Password, not your normal Gmail password.
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password
EMAIL_FROM=Sentinel <your_gmail_address@gmail.com>

# Optional SMTP tuning. Defaults are Gmail-friendly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# Optional. Defaults to 5 minutes.
NOTIFICATION_REPEAT_INTERVAL_MS=300000
