PORT=4000
NODE_ENV=development

SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

JWT_SECRET=replace_with_a_long_random_secret

FRONTEND_URL=https://sentinel-omega-ten.vercel.app
CORS_ORIGINS=https://sentinel-omega-ten.vercel.app,https://sentinel-mvp-nine.vercel.app

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Notification providers
# Africa's Talking SMS credentials
AFRICAS_TALKING_API_KEY=atsk_07aa7dc34edafa3778e7084af8c22d19cc22f0f7cf426c1ff4e0fea524fa9d68d433a32d
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER_ID=

# Gmail SMTP credentials. Use a Gmail App Password, not your normal Gmail password.
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password
EMAIL_FROM=Sentinel <your_gmail_address@gmail.com>

# Optional. Defaults to 5 minutes.
NOTIFICATION_REPEAT_INTERVAL_MS=300000
