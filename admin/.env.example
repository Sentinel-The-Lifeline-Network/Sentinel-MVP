# Password required to log into the admin dashboard.
ADMIN_DASHBOARD_PASSWORD=replace_with_a_strong_password

# Secret used to sign the admin session cookie.
SESSION_SECRET=replace_with_a_long_random_secret

# URL of the Sentinel backend (Express server).
BACKEND_API_URL=https://your-backend.onrender.com

# Must match ADMIN_API_KEY set on the backend server.
ADMIN_API_KEY=replace_with_a_long_random_secret
