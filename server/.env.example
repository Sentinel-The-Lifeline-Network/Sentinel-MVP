PORT=4000
NODE_ENV=development

SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

JWT_SECRET=replace_with_a_long_random_secret

FRONTEND_URL=https://sentinel-omega-ten.vercel.app
CORS_ORIGINS=https://sentinel-omega-ten.vercel.app,https://sentinel-mvp-nine.vercel.app

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Notification providers
# WhatsApp Cloud API credentials from Meta for Developers
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Resend email API key
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Sentinel <onboarding@resend.dev>

# Optional. Defaults to 5 minutes.
NOTIFICATION_REPEAT_INTERVAL_MS=300000
